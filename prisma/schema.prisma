generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum PackageCategory {
  Adventure
  Spiritual
  Expedition
  Retreat
  WomensOnly
}

enum Difficulty {
  Easy
  Moderate
  Intermediate
  Advanced
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ─────────────────────────────────────────
// USER
// Mirrors the Kinde auth user. Created/upserted
// in /api/auth/creation on first login.
// ─────────────────────────────────────────

model User {
  id        String   @id // Kinde user ID (e.g. "kp_...")
  email     String   @unique
  firstName String?
  lastName  String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings             Booking[]
  generatedItineraries GeneratedItinerary[]
}

// ─────────────────────────────────────────
// PACKAGE
// All expedition/tour packages. Content is stored
// in English by default. The `translations` JSON
// field holds overrides for other locales:
// { "hi": { "title": "...", "description": "..." }, "bn": {...} }
// ─────────────────────────────────────────

model Package {
  id             String          @id @default(cuid())
  slug           String          @unique
  destination    String          // e.g. "kashmir", "ladakh"
  category       PackageCategory
  imagePath      String          // e.g. "/destination/Ladakh.png"
  durationDays   Int
  durationNights Int
  difficulty     Difficulty
  maxAltitudeFt  Int?
  priceFrom      Int             // in INR (rupees)
  featured       Boolean         @default(false)
  active         Boolean         @default(true)

  // Primary content (English)
  title          String
  description    String          @db.Text
  highlights     String[]

  // Locale overrides — populated by AI translation layer later
  translations   Json?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       Booking[]

  @@index([category])
  @@index([featured])
  @@index([active])
}

// ─────────────────────────────────────────
// BOOKING
// A user reserving a specific package.
// ─────────────────────────────────────────

model Booking {
  id         String        @id @default(cuid())
  userId     String
  packageId  String
  status     BookingStatus @default(PENDING)
  startDate  DateTime?
  guests     Int           @default(1)
  totalPrice Int           // in INR (rupees)
  notes      String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([packageId])
  @@index([status])
}

// ─────────────────────────────────────────
// GENERATED ITINERARY
// Stores AI-generated custom tour packages.
// The preferences field holds user inputs;
// the itinerary field holds the AI output.
// s3Key is for future PDF storage on AWS S3.
// ─────────────────────────────────────────

model GeneratedItinerary {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  preferences Json     // { destination, budget, duration, groupSize, interests, ... }
  itinerary   Json     // AI-generated structured itinerary
  s3Key       String?  // e.g. "itineraries/userId/itineraryId.pdf"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// ENQUIRIES & ADMIN ACCESS CONTROL
// ─────────────────────────────────────────

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String        @db.Text
  destination String?
  reply       String?       @db.Text
  type        String        @default("TRIP_INQUIRY") // TRIP_INQUIRY, CUSTOM_ITINERARY, RESERVATION
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}


model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      AdminRole @default(ADMIN)
  grantedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

