generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum PackageCategory {
  Adventure
  Spiritual
  Expedition
  Retreat
  WomensOnly
}

enum Difficulty {
  Easy
  Moderate
  Intermediate
  Advanced
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum Currency {
  INR
  EUR
  USD
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─────────────────────────────────────────
// USER
// Mirrors the Kinde auth user. Created/upserted
// in /api/auth/creation on first login.
// ─────────────────────────────────────────

model User {
  id        String   @id // Kinde user ID (e.g. "kp_...")
  email     String   @unique
  firstName String?
  lastName  String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings             Booking[]
  generatedItineraries GeneratedItinerary[]
  reviews              Review[]
}

// ─────────────────────────────────────────
// PACKAGE
// All expedition/tour packages. Content is stored
// in English by default. The `translations` JSON
// field holds overrides for other locales:
// { "hi": { "title": "...", "description": "..." }, "bn": {...} }
// ─────────────────────────────────────────

model Package {
  id             String          @id @default(cuid())
  slug           String          @unique
  destination    String          // e.g. "kashmir", "ladakh"
  category       PackageCategory
  imagePath      String          // e.g. "/destination/Ladakh.png"
  durationDays   Int
  durationNights Int
  difficulty     Difficulty
  maxAltitudeFt  Int?
  priceFromMinor Int             // minor units (paise for INR, cents for EUR/USD) — NEVER a float
  currency       Currency        @default(INR)
  featured       Boolean         @default(false)
  active         Boolean         @default(true)

  // Primary content (English)
  title          String
  description    String          @db.Text
  highlights     String[]

  // Locale overrides — populated by AI translation layer later
  translations   Json?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       Booking[]
  reviews        Review[]

  @@index([category])
  @@index([featured])
  @@index([active])
}

// ─────────────────────────────────────────
// BOOKING
// A user reserving a specific package.
// ─────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  userId          String
  packageId       String
  status          BookingStatus @default(PENDING)
  startDate       DateTime?
  guests          Int           @default(1)
  totalPriceMinor Int           // minor units — server-computed, authoritative. NEVER a float.
  currency        Currency      @default(INR)
  notes           String?       @db.Text
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments Payment[]
  review   Review?

  @@index([userId])
  @@index([packageId])
  @@index([status])
}

// ─────────────────────────────────────────
// PAYMENT
// One row per checkout attempt for a Booking — a
// retried/failed-then-retried booking can have more
// than one. The webhook, not the browser redirect, is
// the source of truth for `status`; see M5/M6 in
// CLAUDE.md before touching this model or its consumers.
// ─────────────────────────────────────────

model Payment {
  id                String          @id @default(cuid())
  bookingId         String
  provider          PaymentProvider
  providerOrderId   String?                           // Stripe session id / Razorpay order id
  providerPaymentId String?         @unique
  amountMinor       Int
  refundedMinor     Int             @default(0)
  currency          Currency
  status            PaymentStatus   @default(CREATED)
  failureReason     String?
  raw               Json?                             // last provider payload, for audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, status])
}

// ─────────────────────────────────────────
// WEBHOOK EVENT
// Idempotency ledger for payment-provider webhooks.
// `providerEventId` is unique so a retried delivery of
// the same event is a guaranteed no-op — see handlePaymentEvent.
// ─────────────────────────────────────────

model WebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String          @unique
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
}

// ─────────────────────────────────────────
// GENERATED ITINERARY
// Stores AI-generated custom tour packages.
// The preferences field holds user inputs;
// the itinerary field holds the AI output.
// s3Key is for future PDF storage on AWS S3.
// ─────────────────────────────────────────

model GeneratedItinerary {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  preferences Json     // { destination, budget, duration, groupSize, interests, ... }
  itinerary   Json     // AI-generated structured itinerary
  totalPriceMinor Int? // computed from real Package components, never model-set
  currency    Currency @default(INR)
  // Draft until an admin approves it — never bookable before then. See A2.
  approved    Boolean  @default(false)
  s3Key       String?  // e.g. "itineraries/userId/itineraryId.pdf"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// ENQUIRIES & ADMIN ACCESS CONTROL
// ─────────────────────────────────────────

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String        @db.Text
  destination String?
  reply       String?       @db.Text
  type        String        @default("TRIP_INQUIRY") // TRIP_INQUIRY, CUSTOM_ITINERARY, RESERVATION
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}


model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      AdminRole @default(ADMIN)
  grantedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

// ─────────────────────────────────────────
// REVIEW
// One review per Booking (verified-purchase gate) —
// `bookingId` is unique so a customer can't review the
// same booking twice. Not visible publicly until an
// admin sets `published = true`.
// ─────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  packageId String
  rating    Int                                       // 1-5, validated in the app layer
  comment   String?  @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@index([packageId, published])
}

