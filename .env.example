# Copy to .env and fill in. Never commit real values - .gitignore covers .env*
# with an explicit exception for this file.

# --- Database (Postgres) ---------------------------------------------------
# DIRECT_URL bypasses the connection pooler; Prisma migrations need it.
DATABASE_URL=
DIRECT_URL=

# --- Auth (Kinde) ----------------------------------------------------------
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://your-tenant.kinde.com

# Drives the OAuth redirect_uri and every link inside outgoing emails.
# Local: http://localhost:3000   Production: https://your-domain
# Must match an allowed callback URL in the Kinde dashboard:
#   <KINDE_SITE_URL>/api/auth/kinde_callback
KINDE_SITE_URL=http://localhost:3000

# Optional. Left unset, next.config.ts derives these from KINDE_SITE_URL.
# If set, the value wins - a stale localhost value here breaks production login.
KINDE_POST_LOGIN_REDIRECT_URL=
KINDE_POST_LOGOUT_REDIRECT_URL=

# --- Object storage (Cloudflare R2) ----------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Email (Resend) --------------------------------------------------------
# Sending access only, restricted to the verified sending domain.
# Unset, all email silently no-ops with a logged warning - the app still runs.
RESEND_API_KEY=

# Reply-To on customer-facing mail. Optional; omitted from the email if blank.
# Need not be on the verified sending domain.
EMAIL_REPLY_TO=

# Who receives internal new-enquiry alerts. Comma-separated.
# Unset, it falls back to every row in the AdminUser table - which means every
# admin-panel user gets one at their personal address. Set this to a dedicated
# inbox to keep the two concerns separate.
ADMIN_ALERT_TO=
